// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USERS & AUTH
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  country       String?   @default("FR")
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  passwordChangedAt DateTime?

  workspaces             Workspace[]
  apiKeys                ApiKey[]
  notifications          Notification[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  agentConversations     AgentConversation[]
  agentActions           AgentAction[]

  @@index([email])
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String   @unique
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String   @unique
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  country             String   @default("FR")
  userId              String
  subscriptionId      String?  @unique
  stripeCustomerId    String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription           Subscription?           @relation(fields: [subscriptionId], references: [id])
  onboardingData         OnboardingData?
  products               Product[]
  listings               Listing[]
  inventories            Inventory[]
  orders                 Order[]
  marketplaceConnections MarketplaceConnection[]
  webhookLogs            WebhookLog[]
  syncLogs               SyncLog[]
  fulfillmentOrders      FulfillmentOrder[]
  webhooks               Webhook[]
  agentConversations     AgentConversation[]
  agentActions           AgentAction[]
  aiUsageEvents          AiUsageEvent[]
  aiUsagePeriods         AiUsagePeriod[]
  aiUsageOverride        WorkspaceAiOverride?

  @@unique([userId, slug])
  @@index([userId])
}

// SUBSCRIPTIONS & BILLING
model Plan {
  id            String  @id @default(cuid())
  name          String  @unique
  displayName   String
  description   String?
  price         Float   @default(0)
  currency      String  @default("EUR")
  billingPeriod String  @default("monthly") // monthly, annual

  // Stripe Configuration
  stripePriceIdMonthly String? // Stripe Price ID for monthly billing
  stripePriceIdAnnual  String? // Stripe Price ID for annual billing

  // Limits
  maxProducts     Int @default(10)
  maxListings     Int @default(50)
  maxOrders       Int @default(100)
  maxMarketplaces Int @default(1)
  maxUsers        Int @default(1)

  // Features
  fulfillmentEnabled Boolean @default(false)
  advancedAnalytics  Boolean @default(false)
  apiAccess          Boolean @default(false)
  autoDelistEnabled  Boolean @default(false)
  aiAssistant        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([name])
}

model Subscription {
  id                   String    @id @default(cuid())
  planId               String
  status               String    @default("active") // active, cancelled, expired, past_due
  startDate            DateTime  @default(now())
  endDate              DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  nextBillingDate      DateTime?
  stripeSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id])
  workspace Workspace?

  @@index([status])
  @@index([planId])
  @@index([stripeSubscriptionId])
}

// PRODUCTS & INVENTORY
model Product {
  id          String  @id @default(cuid())
  workspaceId String
  sku         String
  title       String
  description String  @db.Text
  brand       String?
  category    String?
  size        String?
  color       String?
  condition   String  @default("used") // new, like-new, good, fair, used

  purchasePrice   Float @default(0)
  sellingPrice    Float @default(0)
  fulfillmentCost Float @default(0)
  fees            Float @default(0)

  quantity Int     @default(1) // DB-level CHECK (quantity >= 0) exists in production (added by the stock_race_fix migration); not expressible in Prisma's schema language, so it's undeclared here — do not remove without also dropping the DB constraint. NOT the source of truth for current stock: only set at creation/manual edit, never decremented by a sale — see Inventory.available for the real, live figure.
  location String?

  // Shipping/fulfillment data — nullable: unknown for every product that
  // existed before these columns, and not collected anywhere in the UI
  // yet. Units are explicit in the field names, not left ambiguous.
  weightGrams       Float?
  lengthCm          Float?
  widthCm           Float?
  heightCm          Float?
  // Supplier's own SKU for this product, distinct from Product.sku (ADKSY's
  // own SKU, sent to marketplaces — see ListingService/EbayAdapter/
  // EtsyAdapter). Never used to replace or derive Product.sku.
  supplierSku String?

  // Etsy-specific listing metadata — nullable, unrelated to eBay/Depop/
  // Vinted. Etsy's createDraftListing requires a real taxonomy_id (there
  // is no "generic" fallback ID) and a when_made era bucket on every
  // listing (verified against Etsy's own request schema — see
  // EtsyListingMapper.ts). etsyWhenMade stores the seller's own bucket
  // choice directly (one of EtsyListingMapper.ETSY_WHEN_MADE_OPTIONS) —
  // deliberately not a numeric year ADKSY would have to convert, since
  // that conversion has no honest answer for years outside the verified
  // enum. Both fields must be set before a product can be published to
  // Etsy; ListingService blocks the Etsy publish otherwise rather than
  // guessing.
  etsyTaxonomyId Int? // references EtsyTaxonomyNode.id (no FK: the taxonomy table is a reference cache, not app data)
  etsyWhenMade   String? // one of Etsy's real when_made enum values, chosen by the seller — never inferred

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  listings    Listing[]
  inventories Inventory[]
  orderItems  OrderItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
}

// Read-only cache of Etsy's public seller-taxonomy tree
// (GET /v3/application/seller-taxonomy/nodes). Etsy's taxonomy changes
// rarely, so this is populated by a one-off script
// (scripts/fetch-etsy-taxonomy.ts) run with real Etsy API credentials,
// not fetched live on every product save. `id` is Etsy's own numeric
// taxonomy node ID, not an ADKSY-generated one — Product.etsyTaxonomyId
// references it by value, with no DB-level FK (this table can be empty or
// stale without breaking unrelated app data).
model EtsyTaxonomyNode {
  id       Int     @id
  name     String
  level    Int
  parentId Int?
  fullPath String // human-readable breadcrumb, e.g. "Clothing > Women's Clothing > Dresses" — computed at seed time, not an Etsy API field

  @@index([parentId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String

  // Storage
  url         String // Public URL or signed URL
  storagePath String? // Path in Supabase Storage (for deletion)
  mimeType    String  @default("image/jpeg") // image/jpeg, image/png, etc
  fileSize    Int? // In bytes

  // Metadata
  altText String?
  order   Int     @default(0)
  isMain  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isMain]) // For finding main image
}

// SOURCE OF TRUTH for sellable stock: `available` is what every real sale
// (direct order via ProductService.reserveInventory, and eBay-synced orders
// via OrdersSyncService) actually decrements, atomically and race-free.
// Product.quantity is a separate field only set at product creation/manual
// edit — it is never touched by a sale, so it goes stale as soon as one
// happens. UI that shows "current stock" must read Inventory.available
// (via Product.inventories), never Product.quantity.
model Inventory {
  id           String    @id @default(cuid())
  productId    String
  workspaceId  String
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  available    Int       @default(0)
  lastSyncedAt DateTime?
  syncStatus   String    @default("synced") // synced, pending, failed
  syncError    String?
  updatedAt    DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([productId, workspaceId])
  @@index([workspaceId])
}

// MARKETPLACES
model Marketplace {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  apiUrl      String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  connections MarketplaceConnection[]
}

model MarketplaceConnection {
  id            String  @id @default(cuid())
  workspaceId   String
  marketplaceId String
  status        String  @default("not_connected") // not_connected, connected, mock, expired, error
  apiKey        String?
  apiSecret     String?
  accountId     String?
  accountName   String?

  // OAuth Integration (for eBay/Etsy)
  encryptedOauthToken   String? // Encrypted access token
  encryptedRefreshToken String? // Encrypted refresh token
  tokenExpiresAt        DateTime?

  // Seller Information
  sellerName   String?
  sellerId     String?
  accountEmail String?

  // Sync Tracking
  lastSyncAt        DateTime?
  lastSyncError     String?
  lastApiCallAt     DateTime?
  consecutiveErrors Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace Marketplace  @relation(fields: [marketplaceId], references: [name])
  listings    Listing[]
  webhookLogs WebhookLog[]
  syncLogs    SyncLog[]

  @@unique([workspaceId, marketplaceId])
  @@index([workspaceId])
  @@index([status])
  @@index([lastSyncAt])
}

// WEBHOOK LOGS (for marketplace events)
model WebhookLog {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String?
  marketplace  String // "ebay" | "etsy"

  // Event Identification
  eventId   String // Unique ID from marketplace
  eventType String // "order.created", "listing.sold", etc

  // Payload
  payload String @db.Text // JSON stringified

  // Status
  status      String    @default("processing") // "processing" | "processed" | "failed"
  error       String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // Prevent duplicate processing
  @@unique([workspaceId, marketplace, eventId])
  @@index([workspaceId])
  @@index([marketplace])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

// SYNC LOGS (for tracking synchronization)
model SyncLog {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String?
  marketplace  String // "ebay" | "etsy"
  syncType     String // "listing" | "order" | "inventory" | "status"

  // Execution
  status         String  @default("pending") // "pending" | "in_progress" | "completed" | "failed"
  itemsProcessed Int     @default(0)
  itemsFailed    Int     @default(0)
  error          String?

  // Timing
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  nextScheduledAt DateTime?

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([marketplace])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

// LISTINGS
model Listing {
  id                      String  @id @default(cuid())
  productId               String
  workspaceId             String
  marketplaceConnectionId String?
  externalId              String?

  title       String
  description String  @db.Text
  price       Float
  quantity    Int
  status      String  @default("active") // active, delisted, sold_out, paused
  syncStatus  String  @default("not_synced") // not_synced, syncing, synced, failed
  syncError   String? @db.Text // short, user-facing message when syncStatus = failed. Never raw exceptions/stack traces.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // DB-level partial unique index on (productId, marketplaceConnectionId) WHERE "deletedAt" IS NULL exists in production (Listing_active_product_connection_key, added by the prevent_duplicate_listing_publication migration) — prevents two active publications of the same product on the same connection while still allowing republish after a real delist. Not expressible in Prisma's schema language (no partial/filtered unique index support), so undeclared here — do not remove without also dropping the DB index. See ListingService.createListing for the matching application-level reserve-then-publish guard.

  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [marketplaceConnectionId], references: [id])
  orders     Order[]

  @@index([productId])
  @@index([workspaceId])
  @@index([marketplaceConnectionId])
}

// ORDERS
model Order {
  id              String  @id @default(cuid())
  workspaceId     String
  listingId       String?
  externalOrderId String?

  customerId    String
  customerName  String
  customerEmail String

  totalPrice      Float
  marketplaceFees Float @default(0)
  estimatedProfit Float

  status          String @default("pending") // pending, processing, shipped, delivered, cancelled, error
  fulfillmentType String @default("self") // self, automatic

  // Origin marketplace of this order — 'ebay' | 'etsy' (same string values
  // as MarketplaceConnection.marketplaceId and the app-level Marketplace
  // enum in @/types/marketplace). Plain string, not a relation, matching
  // the existing WebhookLog.marketplace precedent elsewhere in this schema.
  // Null for an order created directly in ADKSY with no known marketplace.
  marketplace String?

  shippingAddress    String  @db.Text
  shippingAddress2   String? @db.Text // line 2 / complement, e.g. apartment or suite
  shippingCity       String
  shippingState      String? // state / province / region
  shippingPostalCode String
  shippingCountry    String
  shippingPhone      String? // recipient phone, when the marketplace provides one
  shippingEmail      String? // recipient email, when the marketplace provides one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing          Listing?          @relation(fields: [listingId], references: [id])
  items            OrderItem[]
  fulfillmentOrder FulfillmentOrder?

  @@index([workspaceId])
  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  title    String
  quantity Int
  price    Float

  // Historical snapshot of Product.purchasePrice at the moment this
  // OrderItem was created — never updated afterwards, so a later edit to
  // Product.purchasePrice never changes an already-recorded sale's cost
  // basis. Null on rows created before this column existed (unknown, not
  // zero — a real cost was never captured for them).
  purchasePrice Float?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// FULFILLMENT
model FulfillmentPartner {
  id         String  @id @default(cuid())
  name       String  @unique
  country    String
  apiUrl     String
  apiKey     String?
  webhookUrl String?
  status     String  @default("active")

  processingTime Int @default(24) // hours
  deliveryTime   Int @default(48) // hours

  costPerOrder Float @default(5)
  costPerKg    Float @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentOrders FulfillmentOrder[]
  shipments         Shipment[]
}

model FulfillmentOrder {
  id          String @id @default(cuid())
  workspaceId String
  orderId     String @unique
  partnerId   String

  externalOrderId String?
  status          String  @default("pending") // pending, accepted, processing, shipped, delivered, failed, cancelled

  quantity  Int
  totalCost Float
  revenue   Float
  profit    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner   FulfillmentPartner @relation(fields: [partnerId], references: [id])
  shipment  Shipment?

  @@index([workspaceId])
  @@index([status])
}

model Shipment {
  id                 String @id @default(cuid())
  fulfillmentOrderId String @unique
  partnerId          String

  trackingNumber    String?
  carrier           String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentOrder FulfillmentOrder   @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  partner          FulfillmentPartner @relation(fields: [partnerId], references: [id])
  trackingEvents   TrackingEvent[]

  @@index([fulfillmentOrderId])
}

model TrackingEvent {
  id         String @id @default(cuid())
  shipmentId String

  status      String
  location    String?
  description String?
  timestamp   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// API & WEBHOOKS
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  key        String    @unique @db.Text
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  events      String   @db.Text // JSON array
  isActive    Boolean  @default(true)
  secret      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // order, fulfillment, system
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ONBOARDING
model OnboardingData {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Step 1: Welcome
  businessName String?
  businessType String? // reseller, dropshipper

  // Step 2: Marketplaces
  marketplaces String[] // ["vinted", "ebay", "depop", "etsy"]

  // Step 3: Volume
  productVolume String? // "1-10", "10-100", "100-1000", "1000+"

  // Step 4: Shipping
  shippingMode    String? // "manual", "partner", "hybrid"
  shippingPartner String? // fulfillment partner ID if selected

  // Step 5: Import
  importMethod String? // "manual", "csv", "api"

  // Step 6: Connections
  connectionsSetup Boolean @default(false)

  currentStep Int       @default(1)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// AI AGENT
// Persists AiAgentService tool-use conversations — distinct from
// AiChatService (the existing Q&A widget), which is deliberately
// stateless (the client resends recent turns per request). The agent is
// multi-step (search -> compare -> draft -> confirm across several tool
// calls), so a server-side record is needed both to let a conversation
// resume across requests and to audit exactly which tools were called for
// a given workspace. Workspace-scoped like every other data model; a
// conversation can never be read across workspaces (see
// AiAgentService/verifyWorkspaceAccess).
model AgentConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  actions   AgentAction[]

  @@index([workspaceId])
  @@index([userId])
}

model AgentMessage {
  id             String @id @default(cuid())
  conversationId String

  role String // 'user' | 'assistant' | 'tool_result'

  // For role='user'/'assistant': the plain text turn.
  // For role='tool_result': the JSON-stringified result AiToolRegistry
  // returned — tool handlers are responsible for never including a
  // token/secret in what they return, so nothing further is scrubbed here.
  content String @db.Text

  // Set only on an assistant turn that called a tool, and on the matching
  // tool_result turn — correlates a call with its result (Anthropic's own
  // tool_use block id), and records which tool ran and its category at
  // call time (kept even if a tool's category changes later, for an
  // accurate audit trail of what was actually allowed to run).
  toolName     String?
  toolUseId    String?
  toolCategory String? // 'read' | 'write' | 'engage' | 'blocked'

  createdAt DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Phase 12A — ADKSY AI Agent Action Framework. A persisted record for any
// tool categorized 'engage' (see AgentToolCategory in
// src/services/ai/tools/types.ts) that the model asked to run: it captures
// exactly what would happen, requires a separate explicit confirmation
// from the reseller, and only then actually executes — the model itself
// never gets direct access to Prisma/Stripe/marketplace credentials; see
// AiActionService for the full propose -> confirm -> execute state
// machine this table backs.
//
// Deliberately does NOT introduce a separate audit-log table: this row's
// own status + confirmedAt/executedAt/updatedAt timestamps ARE the
// durable audit trail (who proposed/confirmed/executed what, and when),
// and AiActionService additionally emits structured logger events at each
// transition for operational visibility — duplicating that into a second
// table would just be the same facts twice.
//
// Workspace-scoped like every other Agent-related model: an action can
// never be read, confirmed, cancelled, or executed across workspaces (see
// AiActionService's own workspaceId-scoped queries).
model AgentAction {
  id             String @id @default(cuid())
  workspaceId    String
  userId         String
  conversationId String

  // The tool name that produced this action (e.g. 'publish_listing') —
  // always one of AiToolRegistry's registered 'engage' tools; never a
  // free-form string a client could invent (see AiActionService.proposeAction,
  // the only place that creates a row here).
  type String
  // Copied from the tool's own category at proposal time (always 'engage'
  // today — 'blocked' tools never reach this table at all, and
  // 'read'/'write' tools auto-execute without ever needing one) so an
  // audit read of an old row is accurate even if a tool's category is
  // later changed.
  category String

  // PENDING_CONFIRMATION | CONFIRMED | EXECUTING | COMPLETED | FAILED |
  // CANCELLED | EXPIRED — see src/lib/ai/agentActionStateMachine.ts for
  // the only code allowed to decide which transitions are legal.
  status String @default("PENDING_CONFIRMATION")

  // JSON-stringified, Zod-validated tool input this action will run with
  // if confirmed — captured once at proposal time so a later confirm can
  // never be re-pointed at different input than what was actually shown
  // to the reseller.
  input String @db.Text
  // JSON-stringified, backend-computed preview (see AgentToolDefinition.preview)
  // — what the reseller actually sees before confirming. Never derived
  // from the model's own text.
  summary String @db.Text

  confirmationRequired Boolean @default(true)
  // Deterministic per (conversationId, toolUseId) at creation — see
  // AiActionService.proposeAction — so the same Anthropic tool_use block
  // can never create two rows, and a workspace-scoped unique index makes
  // that a real DB-enforced guarantee, not just an application-level check.
  idempotencyKey String

  // Set only once execution finishes (COMPLETED/FAILED) — a JSON-stringified,
  // sanitized outcome for COMPLETED, or a short user-facing message (never a
  // raw exception/stack trace) for FAILED.
  result String? @db.Text
  error  String?

  // A pending confirmation is only valid for a limited time (see
  // AiActionService's TTL) — never indefinitely, and never executable once
  // past this timestamp even if the row is still PENDING_CONFIRMATION when
  // read.
  expiresAt   DateTime
  confirmedAt DateTime?
  executedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([conversationId])
  @@index([status])
}

// AI USAGE — commercial quota layer (AiUsageService), strictly separate from
// AiEntitlementService ("do I have the right to use this capability?") and
// from ratelimit.ts ("can I call this endpoint right now?" — infrastructure
// protection, not a commercial budget). See AiUsageService.ts for the full
// design rationale.
//
// One global AI Units budget per (workspace, billing period) — NOT one
// quota per capability — to avoid several independent quota systems that
// could accidentally stack. Each real tool execution has its own AI Units
// cost (see aiUsageConfig.ts), summed into the single AiUsagePeriod bucket
// below.

// Append-only audit trail: one row per real, attempted consumption.
// idempotencyKey mirrors AgentAction's own proven pattern exactly —
// `tool:${conversationId}:${toolUseId}` for an auto-executed read/write
// tool (Anthropic's own real tool_use block id, never a timestamp/random
// UUID), `action:${actionId}` for an 'engage' tool (an AgentAction's own
// id, itself already the product of AgentAction's own idempotent
// propose/confirm flow). The (workspaceId, idempotencyKey) UNIQUE
// constraint is the real, DB-enforced guard against double-counting under
// retry or concurrent double-confirmation — the same role
// AgentAction.idempotencyKey's own unique index already plays.
//
// status: 'RESERVED' is a short-lived internal state used only while
// AiUsageService.recordUsage decides the outcome of the one write that won
// the idempotency race — a caller never observes it, only 'RECORDED' (this
// event really incremented AiUsagePeriod.unitsConsumed) or 'REJECTED'
// (quota exceeded, or quota/period could not be resolved at all — fail
// closed). A REJECTED row is never deleted (kept for audit) and never
// counted twice.
model AiUsageEvent {
  id             String  @id @default(cuid())
  workspaceId    String
  conversationId String?
  actionId       String?
  toolUseId      String?

  toolName   String // AiToolRegistry tool name, e.g. "search_products"
  capability String // AiCapability at the time of recording (see AiEntitlementService) — kept even if the tool's own mapping changes later, for an accurate audit trail
  units      Int // AI Units this event cost, resolved from aiUsageConfig.ts at record time — never recomputed retroactively from a possibly-changed barème
  status     String @default("RESERVED") // RESERVED (transient, never returned to a caller) | RECORDED | REJECTED

  idempotencyKey String

  // The real billing period this consumption is attributed to — see
  // AiUsageService's own period-resolution comment (real Subscription
  // period when one exists, UTC calendar month for Free/no-subscription).
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, periodStart])
}

// One row per (workspace, real billing period) — the fast, O(1)-read
// aggregate counter AiUsageService actually checks/increments.
// unitsConsumed is only ever mutated through the SAME atomic conditional
// updateMany pattern ProductService.reserveInventory already uses on
// Inventory.available (`WHERE unitsConsumed <= limit - units, DATA
// {increment: units}`) — never a separate read-then-write, and never
// wrapped in a $transaction/Serializable block (not needed: a single
// conditional UPDATE is already atomic under PostgreSQL's own row lock).
model AiUsagePeriod {
  id          String @id @default(cuid())
  workspaceId String

  periodStart DateTime
  periodEnd   DateTime

  unitsConsumed Int @default(0)
  // Snapshot of the monthly limit at the moment this period row was first
  // created — kept for historical/audit display only. The live quota
  // check/increment in AiUsageService always re-resolves the CURRENT limit
  // (WorkspaceAiOverride, else the plan's default) instead of trusting
  // this column alone, so a plan upgrade/downgrade mid-period is reflected
  // immediately without recreating the counter row (see AiUsageService).
  unitsLimit Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd])
}

// Enterprise custom quota — a single row overrides the plan's default AI
// Units/month for exactly one workspace, so a new Enterprise contract with
// a bespoke limit never requires a code change (see AiUsageService's
// resolution order: this override, when present, always wins over the
// plan's own default — regardless of which plan the workspace is actually
// on, though in practice only Enterprise workspaces are expected to have
// one). A workspace with no row here simply falls back to its plan's
// default (aiUsageConfig.ts) — an Enterprise workspace works correctly
// with zero rows in this table.
model WorkspaceAiOverride {
  id          String @id @default(cuid())
  workspaceId String @unique

  // Must be a real positive integer — AiUsageService treats 0/negative/
  // missing as an invalid override and fails closed (refuses usage)
  // rather than ever silently falling back to a more permissive default.
  monthlyUnitsLimit Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

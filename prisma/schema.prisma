// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// SCHEMA CONVENTIONS (C6 documentation — comments only, nothing below depends on them)
//
// TENANT ISOLATION. The tenant is the Workspace. Isolation is enforced by the
// APPLICATION, never by the database: there is no row-level security and no DB
// role per tenant. Every query must be scoped by a workspaceId that comes from
// the server session (src/lib/security.ts: verifyWorkspaceAccess /
// getVerifiedWorkspaceId), never from a client-supplied value alone.
// - Directly scoped (own `workspaceId` column): Product, Inventory, Listing,
//   Order, MarketplaceConnection, WebhookLog, SyncLog, FulfillmentOrder,
//   Webhook, AgentConversation, AgentAction, AiUsageEvent, AiUsagePeriod,
//   WorkspaceAiOverride, OnboardingData, AgentProfile.
// - Scoped INDIRECTLY (no workspaceId column — always reach them through their
//   parent, and check the parent's workspace): ProductImage (via Product),
//   OrderItem (via Order), Shipment and TrackingEvent (via FulfillmentOrder),
//   AgentMessage (via AgentConversation).
// - Scoped to a USER, not a workspace: Notification, ApiKey,
//   EmailVerificationToken, PasswordResetToken.
// - GLOBAL (shared by every tenant, hold no tenant data): Plan, Marketplace,
//   FulfillmentPartner, EtsyTaxonomyNode.
// A Workspace has exactly one owner (Workspace.userId); deleting the User or
// the Workspace cascades to the tenant rows listed above.
//
// IDENTIFIERS. Every `id` is a cuid() generated by Prisma (opaque, not
// sequential, not secret). Exceptions: EtsyTaxonomyNode.id is Etsy's own
// numeric id. MarketplaceConnection.marketplaceId stores Marketplace.NAME
// (e.g. "ebay"), not Marketplace.id.
//
// STATUS / TYPE COLUMNS ARE FREE STRINGS. This schema declares no enum: each
// `// a, b, c` comment lists the values the application is known to use, and
// the database accepts any other string. The authoritative list is the code
// that writes the column (named in each comment where known).
//
// MONEY. Every amount is a Float (double precision), never Decimal. Only Plan
// and Order store a currency (Order.currency, added by S8, nullable);
// amounts on Product/Listing/OrderItem/FulfillmentOrder have no column of
// their own: they are in the currency of their Order, or EUR for Product/
// Listing (the app assumes EUR for what the seller enters). Do not sum or
// compare amounts across currencies, and expect binary rounding on cents:
// aggregate through src/lib/financial.ts (integer minor units).
//
// SOFT DELETE. Only User, Product and Listing have `deletedAt`. A row with
// deletedAt set is still in the table: every read that should hide it must
// filter `deletedAt: null` itself (there is no view, no default scope, no
// Prisma middleware). All other models are deleted for real.
//
// TIMESTAMPS. createdAt = @default(now()) at insert; updatedAt = @updatedAt,
// refreshed by Prisma on every Prisma-issued update. A raw SQL statement does
// NOT refresh it (AiUsagePeriod.unitsReserved is changed that way).
//
// OBJECTS THAT EXIST IN THE DATABASE BUT NOT IN THIS FILE. Prisma cannot
// express partial indexes: Listing_active_product_connection_key (see
// Listing) is created by migration 20260914000000 and must not be dropped
// without changing ListingService. Migrating this schema with `prisma db
// push` would not recreate it; use `prisma migrate deploy`.
// =============================================================================

// USERS & AUTH
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Nullable since Google OAuth: a Google-only account has no password
  // at all (never a placeholder/random hash — see
  // src/lib/auth/provisionUser.ts and src/auth.ts's Credentials
  // authorize(), which refuses to call bcrypt.compare against null).
  password      String?
  name          String
  phone         String?
  country       String?   @default("FR")
  // Must be true before any protected API route or dashboard page works
  // (src/lib/security.ts requireAuth / verifyWorkspaceAccess).
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft-delete marker. Nothing in the application sets it today, and only the
  // forgot-password route reads it (it sends no reset link to a deleted user);
  // sign-in does not check it. Do not rely on it to block an account.
  deletedAt     DateTime?
  // Set when the password is reset (PasswordResetService). src/auth.ts compares
  // it with the session token's issue time and rejects older sessions.
  passwordChangedAt DateTime?

  workspaces             Workspace[]
  apiKeys                ApiKey[]
  notifications          Notification[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  agentConversations     AgentConversation[]
  agentActions           AgentAction[]

  @@index([email])
}

// One pending token per user (userId is unique). Only the SHA-256 hash is
// stored; the clear token exists only in the e-mailed link.
model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String   @unique
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One pending token per user; same hashing rule as EmailVerificationToken.
// Deleted when used or found expired.
model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String   @unique
  hashedToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// THE TENANT. See SCHEMA CONVENTIONS above. One owner (userId); the session's
// workspaceId is checked against that owner on every protected request.
model Workspace {
  id                  String   @id @default(cuid())
  name                String
  // Unique across ALL users (not only per owner): the plain slug can collide, so
  // the signup flow (src/lib/auth/provisionUser.ts) derives a distinct one.
  // @@unique([userId, slug]) below is therefore implied by this and redundant.
  slug                String   @unique
  description         String?
  country             String   @default("FR")
  userId              String
  // At most one Subscription per workspace (unique). Null = no paid or explicit
  // subscription row: the application then applies the "free" plan's limits.
  // No onDelete rule: deleting a Workspace does not delete its Subscription row,
  // and does NOT cancel anything at Stripe (see DELETE /api/workspaces/[id]).
  subscriptionId      String?  @unique
  // Stripe customer id (cus_...), created at first checkout. Not a secret, but
  // not for other tenants: never return it outside the owner's own responses.
  stripeCustomerId    String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription           Subscription?           @relation(fields: [subscriptionId], references: [id])
  onboardingData         OnboardingData?
  agentProfile           AgentProfile?
  products               Product[]
  listings               Listing[]
  inventories            Inventory[]
  orders                 Order[]
  marketplaceConnections MarketplaceConnection[]
  webhookLogs            WebhookLog[]
  syncLogs               SyncLog[]
  fulfillmentOrders      FulfillmentOrder[]
  webhooks               Webhook[]
  agentConversations     AgentConversation[]
  agentActions           AgentAction[]
  aiUsageEvents          AiUsageEvent[]
  aiUsagePeriods         AiUsagePeriod[]
  aiUsageOverride        WorkspaceAiOverride?

  @@unique([userId, slug])
  @@index([userId])
}

// SUBSCRIPTIONS & BILLING
// GLOBAL catalogue (not tenant data), one row per plan name: free, starter, pro,
// business, enterprise. Rows are created by prisma/seed-plans-production.js (or
// the local demo seed); the application does not create them. A missing
// "free" row leaves a workspace without plan limits (see SubscriptionService).
model Plan {
  id            String  @id @default(cuid())
  name          String  @unique
  displayName   String
  description   String?
  // Display price per month, in `currency`. Informational: what is actually
  // charged is the Stripe Price below.
  price         Float   @default(0)
  currency      String  @default("EUR")
  // Not read by application code: checkout takes the period from the request
  // ('monthly' | 'annual') and picks the matching Stripe Price ID below.
  billingPeriod String  @default("monthly") // monthly, annual

  // Stripe Configuration
  stripePriceIdMonthly String? // Stripe Price ID for monthly billing
  stripePriceIdAnnual  String? // Stripe Price ID for annual billing

  // Limits (enforced in the services, e.g. SubscriptionService / ProductService /
  // ListingService; not by the database).
  maxProducts     Int @default(10)
  maxListings     Int @default(50)
  maxOrders       Int @default(100)
  maxMarketplaces Int @default(1)
  maxUsers        Int @default(1)

  // Features (read through SubscriptionService.hasFeature). apiAccess is only
  // displayed / gated, no API-key feature exists behind it yet; no application
  // code reads autoDelistEnabled.
  fulfillmentEnabled Boolean @default(false)
  advancedAnalytics  Boolean @default(false)
  apiAccess          Boolean @default(false)
  autoDelistEnabled  Boolean @default(false)
  aiAssistant        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([name])
}

// Billing state of ONE workspace (see Workspace.subscriptionId), kept in sync
// with Stripe by the webhook handlers in StripeService.
model Subscription {
  id                   String    @id @default(cuid())
  planId               String
  // Stripe's own status strings are stored as received (StripeService writes
  // subscription.status), plus 'canceled' (single "l", Stripe's spelling) and
  // 'past_due' written by the handlers: active, trialing, past_due, canceled,
  // unpaid, incomplete, ... The earlier "cancelled, expired" wording never
  // matched the code. Only 'active', 'trialing' and 'past_due' keep paid access
  // (ACCESS_GRANTING_SUBSCRIPTION_STATUSES in SubscriptionService); any other
  // value makes the workspace fall back to the free plan.
  status               String    @default("active")
  startDate            DateTime  @default(now())
  endDate              DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  nextBillingDate      DateTime?
  // Stripe subscription id (sub_...); null for a subscription not managed by Stripe.
  stripeSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id])
  workspace Workspace?

  @@index([status])
  @@index([planId])
  @@index([stripeSubscriptionId])
}

// PRODUCTS & INVENTORY
// Tenant-scoped (workspaceId). Soft-deleted by ProductService.deleteProduct
// (sets deletedAt); the row, its images and its listings stay in the table.
model Product {
  id          String  @id @default(cuid())
  workspaceId String
  // Unique per workspace INCLUDING soft-deleted rows (the constraint below is not
  // partial): the SKU of a soft-deleted product cannot be reused in that workspace.
  sku         String
  title       String
  description String  @db.Text
  brand       String?
  category    String?
  size        String?
  color       String?
  // AI-first listing workflow fix — was captured on ListingDraft.fields.model
  // (edit-only, same rule as size/color: no source equivalent, never
  // guessed) but had no home on Product at all, so it was silently lost
  // between create_product and here. Nullable: every product created
  // before this column existed has none, and that stays a perfectly valid,
  // ordinary state — never backfilled or inferred. Not sent to eBay/Etsy
  // today — same as size/color/material, neither adapter's real
  // createListing payload has a slot for any of these (eBay's only
  // equivalent is Item Specifics/aspects, which this codebase has never
  // implemented for ANY attribute, not even the already-real Brand; adding
  // it only for `model` would be a new, unrequested capability, not a wire-up
  // of an existing one — see actionTools.ts's own comment on this same point).
  model       String?
  condition   String  @default("used") // new, like-new, good, fair, used

  // Amounts: Float, no currency column (see SCHEMA CONVENTIONS - MONEY).
  purchasePrice   Float @default(0)
  sellingPrice    Float @default(0)
  fulfillmentCost Float @default(0)
  fees            Float @default(0)

  // NOT the source of truth for current stock: only set at creation/manual edit,
  // never decremented by a sale - see Inventory.available for the real, live figure.
  // C6/C1 NOTE on a previous comment: it stated that a DB-level CHECK (quantity >= 0)
  // "exists in production, added by the stock_race_fix migration". No such
  // migration exists in prisma/migrations (nor in any commit reachable from a
  // branch), and a database built from the 18 committed migrations has no CHECK
  // constraint and no SQL function at all (verified on the local test database).
  // C1 decision: no migration is created to match the old claim. Whether any real
  // database has such a CHECK is UNVERIFIED from this repository; do not assume
  // it. Non-negative stock is protected by the application, on Inventory.available
  // (ProductService.reserveInventory), not on this column.
  quantity Int     @default(1)
  location String?

  // Shipping/fulfillment data — nullable: unknown for every product that
  // existed before these columns, and not collected anywhere in the UI
  // yet. Units are explicit in the field names, not left ambiguous.
  weightGrams       Float?
  lengthCm          Float?
  widthCm           Float?
  heightCm          Float?
  // Supplier's own SKU for this product, distinct from Product.sku (ADKSY's
  // own SKU, sent to marketplaces — see ListingService/EbayAdapter/
  // EtsyAdapter). Never used to replace or derive Product.sku.
  supplierSku String?

  // Source provenance (Option A, provenance/deduplication architecture
  // decision) — records the ONE external marketplace item this Product
  // was created from, when it was created from a real sourcing result.
  // All three nullable: a manually-created Product has none of them, and
  // that stays a perfectly valid, ordinary state — never backfilled or
  // inferred for pre-existing rows (see this migration's own comment).
  // - sourceMarketplace: the provider/marketplace name (e.g. 'ebay') —
  //   scopes sourceId, since a bare sourceId alone is not guaranteed
  //   unique across different providers.
  // - sourceId: the source's own stable identifier for that specific
  //   listing (e.g. eBay Browse API's item.itemId) — the real
  //   deduplication key, together with sourceMarketplace and workspaceId.
  // - sourceUrl: for traceability/display only — NEVER a deduplication
  //   key (not guaranteed stable: an annonce's URL can change even while
  //   its sourceId does not).
  // Never derived from one another, never generated, never normalized —
  // persisted exactly as given, by design (see ProductService.createProduct).
  sourceMarketplace String?
  sourceId          String?
  sourceUrl         String?

  // Etsy-specific listing metadata — nullable, unrelated to eBay/Depop/
  // Vinted. Etsy's createDraftListing requires a real taxonomy_id (there
  // is no "generic" fallback ID) and a when_made era bucket on every
  // listing (verified against Etsy's own request schema — see
  // EtsyListingMapper.ts). etsyWhenMade stores the seller's own bucket
  // choice directly (one of EtsyListingMapper.ETSY_WHEN_MADE_OPTIONS) —
  // deliberately not a numeric year ADKSY would have to convert, since
  // that conversion has no honest answer for years outside the verified
  // enum. Both fields must be set before a product can be published to
  // Etsy; ListingService blocks the Etsy publish otherwise rather than
  // guessing.
  etsyTaxonomyId Int? // references EtsyTaxonomyNode.id (no FK: the taxonomy table is a reference cache, not app data)
  etsyWhenMade   String? // one of Etsy's real when_made enum values, chosen by the seller — never inferred

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  listings    Listing[]
  inventories Inventory[]
  orderItems  OrderItem[]

  @@unique([workspaceId, sku])
  // Deduplication key for source provenance (Option A) — workspace-scoped
  // exactly like the sku constraint above, deliberately never a global
  // key: two different workspaces must both be able to import the same
  // external source independently (see this constraint's own migration
  // comment). Standard Postgres UNIQUE semantics treat NULL as distinct
  // from every other value (including other NULLs), so any number of
  // Products with no provenance (sourceMarketplace/sourceId both NULL)
  // coexist without ever conflicting with each other or with this
  // constraint — a manually-created Product is never blocked by it.
  @@unique([workspaceId, sourceMarketplace, sourceId])
  @@index([workspaceId])
}

// GLOBAL reference table: no tenant data, readable by any verified user
// (GET /api/etsy/taxonomy).
// Read-only cache of Etsy's public seller-taxonomy tree
// (GET /v3/application/seller-taxonomy/nodes). Etsy's taxonomy changes
// rarely, so this is populated by a one-off script
// (scripts/fetch-etsy-taxonomy.ts) run with real Etsy API credentials,
// not fetched live on every product save. `id` is Etsy's own numeric
// taxonomy node ID, not an ADKSY-generated one — Product.etsyTaxonomyId
// references it by value, with no DB-level FK (this table can be empty or
// stale without breaking unrelated app data).
model EtsyTaxonomyNode {
  id       Int     @id
  name     String
  level    Int
  parentId Int?
  fullPath String // human-readable breadcrumb, e.g. "Clothing > Women's Clothing > Dresses" — computed at seed time, not an Etsy API field

  @@index([parentId])
}

// No workspaceId: tenant scope is the parent Product's. Deleted with the Product
// (cascade). The stored file lives in Supabase Storage under
// `<workspaceId>/<productId>/...` (see StorageService); storagePath is what
// deletion uses, `url` is what is displayed.
model ProductImage {
  id        String @id @default(cuid())
  productId String

  // Storage
  url         String // Public URL or signed URL
  storagePath String? // Path in Supabase Storage (for deletion)
  mimeType    String  @default("image/jpeg") // image/jpeg, image/png, etc
  fileSize    Int? // In bytes

  // Metadata
  altText String?
  order   Int     @default(0)
  isMain  Boolean @default(false)

  // AI-first listing workflow — provenance, so a viewer/marketplace
  // listing never mistakes an AI-generated image for a real product
  // photo. 'REAL' = copied from a real sourcing result's own image URL
  // (see WebSourcingProvider/EbayBrowseSourcingProvider — never
  // fabricated); 'GENERATED' = produced by an ImageGenerationProvider
  // (see src/services/imagegen — none configured yet, see that module's
  // own comment). Nullable: every image uploaded through the existing
  // manual dashboard flow (StorageService.uploadImage) has neither this
  // nor sourceUrl/generationMetadata set — a real, ordinary, unchanged
  // state, never backfilled or inferred for pre-existing rows.
  sourceType String? // 'REAL' | 'GENERATED' | 'USER_UPLOADED'
  // For sourceType='REAL': the exact source image URL this was copied
  // from (may equal `url` when hotlinked, never re-hosted — see
  // actionTools.ts's create_product). For sourceType='GENERATED': not
  // used (generation provenance lives in generationMetadata instead).
  // For sourceType='USER_UPLOADED' (AI-first "free listing creation"
  // workflow — a real photo the reseller sent directly in an agent
  // conversation, see UserUploadedListingImage): null — there is no
  // external source listing to point back to, only the reseller's own
  // upload (`url`/`storagePath` already carry that provenance).
  sourceUrl String?
  // For sourceType='GENERATED' only: JSON-stringified real generation
  // metadata (provider name, prompt actually sent, model, generatedAt) —
  // never fabricated, always exactly what the provider call itself
  // returned/received. Null for a REAL or manually-uploaded image.
  generationMetadata String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isMain]) // For finding main image
}

// SOURCE OF TRUTH for sellable stock: `available` is what every real sale
// (direct order via ProductService.reserveInventory, and eBay-synced orders
// via OrdersSyncService) actually decrements, atomically and race-free.
// Product.quantity is a separate field only set at product creation/manual
// edit — it is never touched by a sale, so it goes stale as soon as one
// happens. UI that shows "current stock" must read Inventory.available
// (via Product.inventories), never Product.quantity.
model Inventory {
  id           String    @id @default(cuid())
  productId    String
  workspaceId  String
  // Invariant maintained by the services, NOT by the database (no CHECK exists):
  // available = quantity - reserved. Sales decrement `available` with a
  // conditional update (ProductService.reserveInventory), so it cannot go below 0
  // through that path.
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  available    Int       @default(0)
  lastSyncedAt DateTime?
  syncStatus   String    @default("synced") // synced, pending, failed
  syncError    String?
  updatedAt    DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([productId, workspaceId])
  @@index([workspaceId])
}

// MARKETPLACES
// GLOBAL reference table (vinted, ebay, depop, etsy). `name`, not `id`, is the
// key other tables reference (MarketplaceConnection.marketplaceId -> name), and
// the lowercase string used as `marketplace` in Order, WebhookLog and SyncLog.
model Marketplace {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  apiUrl      String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  connections MarketplaceConnection[]
}

// One connection per (workspace, marketplace). SENSITIVE: holds credentials.
// Never return a whole row to a client or to the AI model: use
// marketplaceConnectionPublicSelect (src/lib/marketplaceConnectionPublicSelect.ts),
// which omits every credential column.
model MarketplaceConnection {
  id            String  @id @default(cuid())
  workspaceId   String
  // Holds Marketplace.name (not Marketplace.id) - see the relation below.
  marketplaceId String
  // Values written by MarketplaceConnectionService today: not_connected (initial,
  // and after disconnect, which also nulls the tokens), connected, expired
  // (token refresh failed). 'mock' and 'error' were in the original list but no
  // current code writes them.
  status        String  @default("not_connected")
  // apiKey / apiSecret: legacy plaintext columns. No current service writes them;
  // credentials are stored ENCRYPTED in the two columns below (also for Vinted's
  // manual credentials). Keep them out of every response.
  apiKey        String?
  apiSecret     String?
  accountId     String?
  accountName   String?

  // OAuth / manual credentials, encrypted with TOKEN_ENCRYPTION_KEY bound to the
  // workspace (src/services/marketplace token manager). For eBay/Etsy these are the
  // access and refresh tokens; for manual-credential marketplaces they hold the
  // primary and secondary credential.
  encryptedOauthToken   String? // Encrypted access token
  encryptedRefreshToken String? // Encrypted refresh token
  tokenExpiresAt        DateTime?

  // Seller Information
  sellerName   String?
  sellerId     String?
  accountEmail String?

  // Sync Tracking
  lastSyncAt        DateTime?
  lastSyncError     String?
  lastApiCallAt     DateTime?
  consecutiveErrors Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace Marketplace  @relation(fields: [marketplaceId], references: [name])
  listings    Listing[]
  webhookLogs WebhookLog[]
  syncLogs    SyncLog[]

  @@unique([workspaceId, marketplaceId])
  @@index([workspaceId])
  @@index([status])
  @@index([lastSyncAt])
}

// WEBHOOK LOGS - idempotency ledger for incoming events. Despite the name it is
// also used for Stripe: the Stripe webhook route records its events here with
// marketplace = "stripe" (payload = the event type only, not the event body).
model WebhookLog {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String?
  marketplace  String // "ebay" | "etsy" | "stripe"

  // Event Identification
  eventId   String // Unique ID from marketplace
  eventType String // "order.created", "listing.sold", etc

  // Payload
  payload String @db.Text // JSON stringified

  // Status
  status      String    @default("processing") // "processing" | "processed" | "failed"
  // Raw error text (up to 2000 chars) of a failed handler: internal, never return it.
  error       String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // Prevent duplicate processing
  @@unique([workspaceId, marketplace, eventId])
  @@index([workspaceId])
  @@index([marketplace])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

// SYNC LOGS (for tracking synchronization)
model SyncLog {
  id           String  @id @default(cuid())
  workspaceId  String
  connectionId String?
  marketplace  String // "ebay" | "etsy"
  syncType     String // "listing" | "order" | "inventory" | "status"

  // Execution
  status         String  @default("pending") // "pending" | "in_progress" | "completed" | "failed"
  itemsProcessed Int     @default(0)
  itemsFailed    Int     @default(0)
  error          String?

  // Timing
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  nextScheduledAt DateTime?

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([marketplace])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

// LISTINGS - one product published (or being published) on one connection.
// Tenant-scoped (workspaceId); `price` is a Float with no currency (see
// SCHEMA CONVENTIONS - MONEY). Soft-deleted by ListingService when delisted
// (deletedAt set, status 'delisted').
model Listing {
  id                      String  @id @default(cuid())
  productId               String
  workspaceId             String
  marketplaceConnectionId String?
  externalId              String?

  title       String
  description String  @db.Text
  price       Float
  quantity    Int
  // Values the code reads/writes: active, delisted, sold_out ('paused' is listed but
  // not written by current services).
  status      String  @default("active") // active, delisted, sold_out, paused
  syncStatus  String  @default("not_synced") // not_synced, syncing, synced, failed
  syncError   String? @db.Text // short, user-facing message when syncStatus = failed. Never raw exceptions/stack traces.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // DB-level partial unique index on (productId, marketplaceConnectionId) WHERE "deletedAt" IS NULL exists in production (Listing_active_product_connection_key, added by the prevent_duplicate_listing_publication migration) — prevents two active publications of the same product on the same connection while still allowing republish after a real delist. Not expressible in Prisma's schema language (no partial/filtered unique index support), so undeclared here — do not remove without also dropping the DB index. See ListingService.createListing for the matching application-level reserve-then-publish guard.

  product    Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection MarketplaceConnection? @relation(fields: [marketplaceConnectionId], references: [id])
  orders     Order[]

  @@index([productId])
  @@index([workspaceId])
  @@index([marketplaceConnectionId])
}

// ORDERS - tenant-scoped (workspaceId). Never soft-deleted. CONTAINS PERSONAL
// DATA of the buyer (name, e-mail, shipping address, phone): only ever return it
// to the owning workspace.
model Order {
  id              String  @id @default(cuid())
  workspaceId     String
  listingId       String?
  // The marketplace's own order id for orders imported by OrdersSyncService; null
  // for an order created directly in ADKSY.
  externalOrderId String?

  customerId    String
  customerName  String
  customerEmail String

  // ISO 4217 code (e.g. "EUR", "GBP", "USD") of totalPrice, marketplaceFees and estimatedProfit, as reported
  // by the marketplace at import (S8). NULL = never recorded: rows created before this column existed, and
  // orders created inside ADKSY (accounted in EUR by the app-wide convention). A synced order with a NULL
  // currency is accounted as "UNKNOWN", never assumed to be EUR. Amounts of different currencies must never
  // be added together (src/lib/financial.ts).
  currency        String?
  // Amounts: Float (see SCHEMA CONVENTIONS - MONEY); the unit is `currency` above.
  totalPrice      Float
  marketplaceFees Float @default(0)
  // Computed by the creator of the order. Orders imported from a marketplace are
  // stored with estimatedProfit = 0 (OrdersSyncService), so profit totals that
  // include synced orders understate real profit (known limit, not changed here).
  estimatedProfit Float

  // Written values: pending, processing, shipped, delivered, cancelled (FulfillmentService
  // also sets 'error' when a send to the partner fails).
  status          String @default("pending") // pending, processing, shipped, delivered, cancelled, error
  fulfillmentType String @default("self") // self, automatic

  // Origin marketplace of this order — 'ebay' | 'etsy' (same string values
  // as MarketplaceConnection.marketplaceId and the app-level Marketplace
  // enum in @/types/marketplace). Plain string, not a relation, matching
  // the existing WebhookLog.marketplace precedent elsewhere in this schema.
  // Null for an order created directly in ADKSY with no known marketplace.
  marketplace String?

  shippingAddress    String  @db.Text
  shippingAddress2   String? @db.Text // line 2 / complement, e.g. apartment or suite
  shippingCity       String
  shippingState      String? // state / province / region
  shippingPostalCode String
  shippingCountry    String
  shippingPhone      String? // recipient phone, when the marketplace provides one
  shippingEmail      String? // recipient email, when the marketplace provides one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing          Listing?          @relation(fields: [listingId], references: [id])
  items            OrderItem[]
  fulfillmentOrder FulfillmentOrder?

  @@index([workspaceId])
  @@index([status])
  @@index([customerId])
}

// No workspaceId: tenant scope is the parent Order's. No onDelete on `product`:
// a Product that has order items cannot be hard-deleted (soft-delete it).
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  title    String
  quantity Int
  price    Float

  // Historical snapshot of Product.purchasePrice at the moment this
  // OrderItem was created — never updated afterwards, so a later edit to
  // Product.purchasePrice never changes an already-recorded sale's cost
  // basis. Null on rows created before this column existed (unknown, not
  // zero — a real cost was never captured for them).
  purchasePrice Float?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// FULFILLMENT
// GLOBAL (not per workspace): every tenant sees the same partners. SENSITIVE
// columns: apiKey and webhookUrl are excluded from API responses by
// src/lib/publicResponseSelects.ts - never select a whole row for a client.
model FulfillmentPartner {
  id         String  @id @default(cuid())
  name       String  @unique
  country    String
  apiUrl     String
  apiKey     String?
  webhookUrl String?
  status     String  @default("active")

  // Fulfillment Integration Foundation V1 (Phase C) — which
  // FulfillmentProvider (see src/services/fulfillment/registry.ts, e.g.
  // "mock") this partner's real integration is wired to. Nullable, no
  // default: every partner row that exists today (including the seeded
  // "ShipMock France") has NULL here, and that stays a perfectly valid,
  // ordinary state — FulfillmentService.sendToFulfillment's historical,
  // provider-less behavior is preserved EXACTLY for any partner with
  // providerId=null. Only a partner explicitly given a real value here
  // (never inferred from its name) is ever dispatched to a real
  // FulfillmentProvider. Never a required field, never backfilled.
  providerId String?

  processingTime Int @default(24) // hours
  deliveryTime   Int @default(48) // hours

  costPerOrder Float @default(5)
  costPerKg    Float @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentOrders FulfillmentOrder[]
  shipments         Shipment[]
}

// One fulfillment per Order (orderId unique). Tenant-scoped (workspaceId); the
// workspace must equal the Order's - application-enforced, not a DB constraint.
model FulfillmentOrder {
  id          String @id @default(cuid())
  workspaceId String
  orderId     String @unique
  partnerId   String

  externalOrderId String?
  status          String  @default("pending") // pending, accepted, processing, shipped, delivered, failed, cancelled

  quantity  Int
  totalCost Float
  revenue   Float
  profit    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner   FulfillmentPartner @relation(fields: [partnerId], references: [id])
  shipment  Shipment?

  @@index([workspaceId])
  @@index([status])
}

// No workspaceId: tenant scope is the FulfillmentOrder's (one shipment per
// fulfillment order). TrackingEvent below is scoped through the Shipment.
model Shipment {
  id                 String @id @default(cuid())
  fulfillmentOrderId String @unique
  partnerId          String

  trackingNumber    String?
  carrier           String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillmentOrder FulfillmentOrder   @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  partner          FulfillmentPartner @relation(fields: [partnerId], references: [id])
  trackingEvents   TrackingEvent[]

  @@index([fulfillmentOrderId])
}

model TrackingEvent {
  id         String @id @default(cuid())
  shipmentId String

  status      String
  location    String?
  description String?
  timestamp   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// API & WEBHOOKS
// ApiKey and Webhook are declared but no application code creates or reads them
// today (only the test harness does): they are placeholders for the `apiAccess`
// plan feature. If they get used, `key` / `secret` must be stored hashed or
// encrypted - the columns currently have no such protection.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  key        String    @unique @db.Text
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  events      String   @db.Text // JSON array
  isActive    Boolean  @default(true)
  secret      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Scoped to a USER (the workspace owner), not to a workspace.
// NotificationService resolves Workspace.userId when it creates one.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  // Types written by NotificationService / the agent tools include: new_order,
  // order_accepted, order_preparing, listing_draft_ready.
  type      String // order, fulfillment, system
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // AI-first listing workflow — an in-app relative path (e.g.
  // "/dashboard/agent?conversationId=...") the notification UI can
  // navigate to directly, e.g. so "Ton annonce Prada Cut est prête à
  // être vérifiée" opens the exact conversation/draft it's about.
  // Nullable: every notification type that existed before this field
  // (new_order, subscription_created, ...) has none, and that stays a
  // perfectly valid, ordinary state — never backfilled or inferred.
  link String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ONBOARDING - at most one row per workspace, created on first use
// (OnboardingService.getOrCreateOnboarding). The listed values are the UI's
// suggestions; POST /api/onboarding only bounds their length, it does not check
// them against these lists.
model OnboardingData {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Step 1: Welcome
  businessName String?
  businessType String? // reseller, dropshipper

  // Step 2: Marketplaces
  marketplaces String[] // ["vinted", "ebay", "depop", "etsy"]

  // Step 3: Volume
  productVolume String? // "1-10", "10-100", "100-1000", "1000+"

  // Step 4: Shipping
  shippingMode    String? // "manual", "partner", "hybrid"
  shippingPartner String? // fulfillment partner ID if selected

  // Step 5: Import
  importMethod String? // "manual", "csv", "api"

  // Step 6: Connections
  connectionsSetup Boolean @default(false)

  currentStep Int       @default(1)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// AI AGENT PERSONALIZATION
// A reseller's self-declared, general preferences for the AI Agent —
// never a constraint, always overridable by an explicit statement in the
// current conversation (see AiAgentService.buildSystemPrompt and
// src/lib/ai/agentProfile.ts's own formatAgentProfileForPrompt). Same
// 1:1-optional-on-Workspace shape as OnboardingData above — workspace-
// scoped (never user-scoped alone), consistent with AgentConversation/
// AgentAction, and with the fact that a Workspace has exactly one owning
// User in this codebase (see verifyWorkspaceAccess). Absent (null) is a
// perfectly valid, permanent state — a reseller can always skip the
// onboarding past the first question, or never complete it at all, and
// the Agent behaves exactly as it did before this model existed.
model AgentProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Only truly required field — every other field may be skipped during
  // onboarding and stays null indefinitely.
  usageType String // 'resell' | 'dropshipping' | 'personal' | 'other'

  // General, non-sensitive preference — never converted into a numeric
  // minPrice/maxPrice automatically (see agentProfile.ts). 'custom' pairs
  // with customBudgetEur; any other value leaves it null.
  budgetRange     String? // 'under_30' | '30_50' | '50_100' | '100_200' | '200_plus' | 'custom'
  customBudgetEur Float?

  sellingPlatforms    String[] // e.g. ['vinted', 'ebay', 'etsy', 'shopify', 'woocommerce', 'other']
  preferredCategories String[] // e.g. ['sneakers', 'clothing', 'luxury', 'accessories', 'electronics', 'other']

  monthlyGoal String? // '500' | '1000' | '3000' | '5000' | '10000_plus' | 'unknown'
  // Resell/dropshipping priority — vocabulary differs slightly by
  // usageType (see agentProfile.ts's own per-usage-type option list);
  // stored as the same free string either way.
  priority    String? // 'margin' | 'ease_of_sale' | 'trending' | 'low_cost' | 'balanced' | 'shipping_ease'

  // 'personal' usageType only — never asked of a reseller/dropshipper.
  qualityVsPrice String? // 'save_money' | 'quality'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI AGENT
// Persists AiAgentService tool-use conversations — distinct from
// AiChatService (the existing Q&A widget), which is deliberately
// stateless (the client resends recent turns per request). The agent is
// multi-step (search -> compare -> draft -> confirm across several tool
// calls), so a server-side record is needed both to let a conversation
// resume across requests and to audit exactly which tools were called for
// a given workspace. Workspace-scoped like every other data model; a
// conversation can never be read across workspaces (see
// AiAgentService/verifyWorkspaceAccess).
model AgentConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  actions   AgentAction[]

  @@index([workspaceId])
  @@index([userId])
}

model AgentMessage {
  id             String @id @default(cuid())
  conversationId String

  role String // 'user' | 'assistant' | 'tool_result'

  // For role='user'/'assistant': the plain text turn.
  // For role='tool_result': the JSON-stringified result AiToolRegistry
  // returned — tool handlers are responsible for never including a
  // token/secret in what they return, so nothing further is scrubbed here.
  content String @db.Text

  // Set only on an assistant turn that called a tool, and on the matching
  // tool_result turn — correlates a call with its result (Anthropic's own
  // tool_use block id), and records which tool ran and its category at
  // call time (kept even if a tool's category changes later, for an
  // accurate audit trail of what was actually allowed to run).
  toolName     String?
  toolUseId    String?
  toolCategory String? // 'read' | 'write' | 'engage' | 'blocked'

  createdAt DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Phase 12A — ADKSY AI Agent Action Framework. A persisted record for any
// tool categorized 'engage' (see AgentToolCategory in
// src/services/ai/tools/types.ts) that the model asked to run: it captures
// exactly what would happen, requires a separate explicit confirmation
// from the reseller, and only then actually executes — the model itself
// never gets direct access to Prisma/Stripe/marketplace credentials; see
// AiActionService for the full propose -> confirm -> execute state
// machine this table backs.
//
// Deliberately does NOT introduce a separate audit-log table: this row's
// own status + confirmedAt/executedAt/updatedAt timestamps ARE the
// durable audit trail (who proposed/confirmed/executed what, and when),
// and AiActionService additionally emits structured logger events at each
// transition for operational visibility — duplicating that into a second
// table would just be the same facts twice.
//
// Workspace-scoped like every other Agent-related model: an action can
// never be read, confirmed, cancelled, or executed across workspaces (see
// AiActionService's own workspaceId-scoped queries).
model AgentAction {
  id             String @id @default(cuid())
  workspaceId    String
  userId         String
  conversationId String

  // The tool name that produced this action (e.g. 'publish_listing') —
  // always one of AiToolRegistry's registered 'engage' tools; never a
  // free-form string a client could invent (see AiActionService.proposeAction,
  // the only place that creates a row here).
  type String
  // Copied from the tool's own category at proposal time (always 'engage'
  // today — 'blocked' tools never reach this table at all, and
  // 'read'/'write' tools auto-execute without ever needing one) so an
  // audit read of an old row is accurate even if a tool's category is
  // later changed.
  category String

  // PENDING_CONFIRMATION | CONFIRMED | EXECUTING | COMPLETED | FAILED |
  // CANCELLED | EXPIRED — see src/lib/ai/agentActionStateMachine.ts for
  // the only code allowed to decide which transitions are legal.
  status String @default("PENDING_CONFIRMATION")

  // JSON-stringified, Zod-validated tool input this action will run with
  // if confirmed — captured once at proposal time so a later confirm can
  // never be re-pointed at different input than what was actually shown
  // to the reseller.
  input String @db.Text
  // JSON-stringified, backend-computed preview (see AgentToolDefinition.preview)
  // — what the reseller actually sees before confirming. Never derived
  // from the model's own text.
  summary String @db.Text

  confirmationRequired Boolean @default(true)
  // Deterministic per (conversationId, toolUseId) at creation — see
  // AiActionService.proposeAction — so the same Anthropic tool_use block
  // can never create two rows, and a workspace-scoped unique index makes
  // that a real DB-enforced guarantee, not just an application-level check.
  idempotencyKey String

  // Set only once execution finishes (COMPLETED/FAILED) — a JSON-stringified,
  // sanitized outcome for COMPLETED, or a short user-facing message (never a
  // raw exception/stack trace) for FAILED.
  result String? @db.Text
  error  String?

  // A pending confirmation is only valid for a limited time (see
  // AiActionService's TTL) — never indefinitely, and never executable once
  // past this timestamp even if the row is still PENDING_CONFIRMATION when
  // read.
  expiresAt   DateTime
  confirmedAt DateTime?
  executedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([conversationId])
  @@index([status])
}

// AI USAGE — commercial quota layer (AiUsageService), strictly separate from
// AiEntitlementService ("do I have the right to use this capability?") and
// from ratelimit.ts ("can I call this endpoint right now?" — infrastructure
// protection, not a commercial budget). See AiUsageService.ts for the full
// design rationale.
//
// One global AI Units budget per (workspace, billing period) — NOT one
// quota per capability — to avoid several independent quota systems that
// could accidentally stack. Each real tool execution has its own AI Units
// cost (see aiUsageConfig.ts), summed into the single AiUsagePeriod bucket
// below.

// Append-only audit trail: one row per real, attempted consumption.
// idempotencyKey mirrors AgentAction's own proven pattern exactly —
// `tool:${conversationId}:${toolUseId}` for an auto-executed read/write
// tool (Anthropic's own real tool_use block id, never a timestamp/random
// UUID), `action:${actionId}` for an 'engage' tool (an AgentAction's own
// id, itself already the product of AgentAction's own idempotent
// propose/confirm flow). The (workspaceId, idempotencyKey) UNIQUE
// constraint is the real, DB-enforced guard against double-counting under
// retry or concurrent double-confirmation — the same role
// AgentAction.idempotencyKey's own unique index already plays.
//
// status is a real, externally-visible lifecycle (Race-condition fix —
// see AiUsageService.reserveUsage/finalizeUsage/releaseUsage):
// - RESERVED: units are atomically held in AiUsagePeriod.unitsReserved for
//   an execution currently in flight. A handler is only ever allowed to
//   run once its event reaches this state.
// - RECORDED: the handler succeeded; reserveUsage's hold was moved from
//   unitsReserved into unitsConsumed — the real, final, billed outcome.
// - REJECTED: the reservation itself was refused (insufficient quota, or
//   quota/period could not be resolved at all — fail closed). No units
//   were ever held for this event.
// - RELEASED: a reservation was granted but the handler then failed (or
//   returned a controlled business error) — its held units were given
//   back to unitsReserved->0, never counted as consumed (V1's own
//   FAILED = 0 rule). The row itself is never deleted or reused; a
//   released idempotencyKey is retired for good, never silently
//   re-reserved (see AiUsageService's own comment on why).
// No row here is ever deleted, and no non-RESERVED status is ever
// revisited by a later reserveUsage/finalizeUsage/releaseUsage call for
// the same idempotencyKey (all three transitions out of RESERVED are
// themselves conditional UPDATEs gated on status = RESERVED, so at most
// one of finalize/release can ever win for a given event).
model AiUsageEvent {
  id             String  @id @default(cuid())
  workspaceId    String
  conversationId String?
  actionId       String?
  toolUseId      String?

  toolName   String // AiToolRegistry tool name, e.g. "search_products"
  capability String // AiCapability at the time of recording (see AiEntitlementService) — kept even if the tool's own mapping changes later, for an accurate audit trail
  units      Int // AI Units this event cost, resolved from aiUsageConfig.ts at reservation time — never recomputed retroactively from a possibly-changed barème
  status     String @default("RESERVED") // RESERVED | RECORDED | REJECTED | RELEASED

  idempotencyKey String

  // The real billing period this consumption is attributed to — see
  // AiUsageService's own period-resolution comment (real Subscription
  // period when one exists, UTC calendar month for Free/no-subscription).
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, periodStart])
}

// One row per (workspace, real billing period) — the fast, O(1)-read
// aggregate counters AiUsageService actually checks/reserves/finalizes.
// unitsReserved is only ever mutated by reserveUsage's atomic conditional
// raw UPDATE (`WHERE unitsConsumed + unitsReserved + units <= limit`) —
// a two-column arithmetic condition Prisma's query builder cannot express
// as a single filter, so this one statement uses `$executeRaw` rather
// than `updateMany` (see AiUsageService.reserveUsage's own comment); it
// is still a single atomic PostgreSQL UPDATE under the same row lock
// guarantee as ProductService.reserveInventory's own conditional
// `updateMany` on Inventory.available, never `$transaction`/Serializable.
// unitsConsumed is only ever mutated by finalizeUsage (moving units out
// of unitsReserved once a handler has genuinely succeeded), via a plain
// conditional `updateMany`, since that step needs no cross-column
// arithmetic — it is gated instead by AiUsageEvent's own RESERVED->
// RECORDED transition (see that model's own comment).
model AiUsagePeriod {
  id          String @id @default(cuid())
  workspaceId String

  periodStart DateTime
  periodEnd   DateTime

  unitsConsumed Int @default(0)
  // Units currently held by an in-flight AiUsageEvent (status RESERVED) —
  // moved into unitsConsumed on success (AiUsageService.finalizeUsage) or
  // released back to 0 on failure (AiUsageService.releaseUsage). Added to
  // close a race the original V1 design left open: a plain non-atomic
  // hasQuotaRemaining() pre-check followed later by an unconditional
  // handler execution let two concurrent requests both pass the check and
  // both actually run their handler, even though only one had real budget
  // — the DB counter itself never overflowed, but the HANDLER could still
  // execute beyond quota. reserveUsage() now atomically claims capacity
  // here, in the SAME statement that verifies it (see that method's own
  // comment for why this needs a raw SQL UPDATE, not the query builder),
  // strictly BEFORE any handler is ever allowed to run.
  unitsReserved Int @default(0)
  // Snapshot of the monthly limit at the moment this period row was first
  // created — kept for historical/audit display only. The live quota
  // check/reservation in AiUsageService always re-resolves the CURRENT
  // limit (WorkspaceAiOverride, else the plan's default) instead of
  // trusting this column alone, so a plan upgrade/downgrade mid-period is
  // reflected immediately without recreating the counter row (see
  // AiUsageService).
  unitsLimit Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, periodEnd])
}

// Enterprise custom quota — a single row overrides the plan's default AI
// Units/month for exactly one workspace, so a new Enterprise contract with
// a bespoke limit never requires a code change (see AiUsageService's
// resolution order: this override, when present, always wins over the
// plan's own default — regardless of which plan the workspace is actually
// on, though in practice only Enterprise workspaces are expected to have
// one). A workspace with no row here simply falls back to its plan's
// default (aiUsageConfig.ts) — an Enterprise workspace works correctly
// with zero rows in this table.
model WorkspaceAiOverride {
  id          String @id @default(cuid())
  workspaceId String @unique

  // Must be a real positive integer — AiUsageService treats 0/negative/
  // missing as an invalid override and fails closed (refuses usage)
  // rather than ever silently falling back to a more permissive default.
  monthlyUnitsLimit Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

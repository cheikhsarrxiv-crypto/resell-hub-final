# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reselling_saas"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (configure in Stripe Dashboard)
# Format: price_1234567890abcdefghijklmn
# These are REQUIRED for checkout to work
STRIPE_PRICE_ID_STARTER_MONTHLY="price_..."
STRIPE_PRICE_ID_STARTER_ANNUAL="price_..."
STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
STRIPE_PRICE_ID_PRO_ANNUAL="price_..."
STRIPE_PRICE_ID_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_ID_BUSINESS_ANNUAL="price_..."

# Storage (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Storage Configuration
# Bucket: "products" (create in Supabase Storage)
# Note: Bucket must be public for URL access

# API Keys for marketplaces (will be entered by user through UI)
# These are optional - users provide their own credentials

# Admin credentials (first setup)
ADMIN_EMAIL="admin@reselling.local"
ADMIN_PASSWORD="changeme123"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Reselling SaaS"


# Email Service Configuration
# Provider options: sendgrid, mailgun, resend, none (default)
# If EMAIL_PROVIDER=none, emails are logged but not sent
EMAIL_PROVIDER="none"
EMAIL_FROM="noreply@resellhub.local"
EMAIL_FROM_NAME="ResellHub"

# SendGrid Configuration (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY="SG.xxxxx"

# Mailgun Configuration (if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY="key-xxxxx"
MAILGUN_DOMAIN="mg.resellhub.local"

# Resend Configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_xxxxx"

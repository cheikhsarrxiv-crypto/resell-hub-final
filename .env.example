# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reselling_saas"
# Direct (non-pooled) connection — used only by Prisma Migrate.
# On Supabase: Project Settings -> Database -> Connection string -> "Direct connection".
DIRECT_URL="postgresql://user:password@localhost:5432/reselling_saas"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (configure in Stripe Dashboard)
# Format: price_1234567890abcdefghijklmn
# These are REQUIRED for checkout to work
STRIPE_PRICE_ID_STARTER_MONTHLY="price_..."
STRIPE_PRICE_ID_STARTER_ANNUAL="price_..."
STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
STRIPE_PRICE_ID_PRO_ANNUAL="price_..."
STRIPE_PRICE_ID_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_ID_BUSINESS_ANNUAL="price_..."

# Storage (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Storage Configuration
# Bucket: "products" (create in Supabase Storage)
# Note: Bucket must be public for URL access

# API Keys for marketplaces (will be entered by user through UI)
# These are optional - users provide their own credentials

# eBay (required for eBay OAuth connect)
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_REDIRECT_URI="http://localhost:3000/api/marketplace/callback/ebay"
EBAY_SANDBOX_MODE="true"

# eBay Buy Browse API — sourcing/search only (Agent IA's search_products
# tool, see src/services/sourcing/providers/EbayBrowseSourcingProvider.ts).
# Completely separate from the seller OAuth credentials above: this uses
# the client_credentials grant (an application-wide access token, never
# tied to a connected seller's account) and the public read scope
# https://api.ebay.com/oauth/api_scope. Can be the same eBay application
# as EBAY_CLIENT_ID/EBAY_CLIENT_SECRET above if you want (same "app"
# keyset can support both grant types), but is read as its own pair of
# variables on purpose, so nothing here is affected by — or can affect —
# the separate seller OAuth Sandbox/Production fix in progress.
EBAY_BUY_API_CLIENT_ID=""
EBAY_BUY_API_CLIENT_SECRET=""

# Pricing/Margin Engine (calculate_margin tool, see
# src/services/pricing/) — all OPTIONAL and OFF by default. Leaving these
# unset means CurrencyConversionService/MarketplaceFeeProvider correctly
# report "unavailable"/"not configured" rather than guessing a number.
#
# CURRENCY_STATIC_RATES: a JSON object of operator-supplied exchange
# rates, keyed "FROM_TO" (ISO 4217), e.g. {"GBP_EUR": 1.17}. These are
# NOT live market rates — set only if you have a rate you're willing to
# stand behind, and expect it to go stale.
CURRENCY_STATIC_RATES=""

# FRANKFURTER_FX_ENABLED: set to exactly "true" to let
# CurrencyConversionService fall back to Frankfurter (frankfurter.dev), a
# free, no-key API serving the European Central Bank's daily REFERENCE
# exchange rates (~30 major currencies) — see
# src/services/pricing/providers/FrankfurterCurrencyProvider.ts. These
# are NOT live market/trading rates; every result is tagged
# 'ecb_reference_rate' and treated as an estimate, never presented as an
# exact fact. Off by default: adding a new outbound network dependency to
# this engine is an explicit opt-in, not automatic.
FRANKFURTER_FX_ENABLED=""

# MARKETPLACE_FEE_CONFIG: a JSON object keyed by marketplace name (e.g.
# "ebay", "etsy") with each marketplace's real seller fee structure —
# either a flat rate (e.g. Etsy-like) or a "tiers" array for a
# progressive/bracket fee like eBay's real final value fee, e.g.
# {"etsy": {"marketplace": "etsy", "percentageFee": 0.065, "source": "https://www.etsy.com/legal/fees/ (checked <date>)"},
#  "ebay": {"marketplace": "ebay", "tiers": [{"upTo": 7500, "percentageFee": 0.136}, {"percentageFee": 0.0235}], "source": "https://www.ebay.com/help/selling/fees-credits-invoices/selling-fees?id=4364 (checked <date>)"}}.
# "source" is required by MarketplaceFeeProvider's own type — never fill
# this in with a percentage you haven't verified against that
# marketplace's current published fee page. Left empty by default; no
# real rate is shipped in this codebase.
MARKETPLACE_FEE_CONFIG=""

# ENABLE_REAL_EBAY_PUBLISH — the single switch deciding whether the AI
# Agent's publish_listing tool (see
# src/services/ai/tools/ebayPublishGuard.ts) is ever allowed to make a
# REAL, authenticated call to eBay and actually create a live listing.
# Must be the exact string "true", set explicitly, to have any effect —
# unset, empty, or any other value keeps real publishing BLOCKED, which
# is the safe default. This is deliberately separate from
# EBAY_SANDBOX_MODE above: EBAY_SANDBOX_MODE only decides WHICH eBay host
# a real call would hit (sandbox vs production); this flag decides
# WHETHER a real call happens AT ALL. Leave unset in every environment
# until real eBay publishing from the Agent has been explicitly reviewed
# and approved.
ENABLE_REAL_EBAY_PUBLISH=""

# ALLOW_PRODUCTION_PLAN_SEED — gates prisma/seed-plans-production.js, the
# production-safe plan seeding script (creates only Plan rows that don't
# exist yet; never modifies an existing Plan row — see that file's own
# header comment). Without this set to the exact string "true", running
# the script only prints a read-only summary and writes nothing — the
# same behavior as its own --dry-run flag. Leave unset by default; set it
# to "true" only for the single deliberate run that seeds missing plans
# in a real environment, then unset it again.
ALLOW_PRODUCTION_PLAN_SEED=""

# Etsy (Open API v3 — https://developer.etsy.com/documentation/)
# ETSY_CLIENT_ID is the app's "keystring" from the Etsy Developer Portal
# Requires OAuth 2.0 + PKCE. Etsy provides no separate sandbox/test API —
# these credentials hit the real Etsy API, there is no ETSY_SANDBOX_MODE.
ETSY_CLIENT_ID=""
ETSY_CLIENT_SECRET=""
ETSY_REDIRECT_URI="http://localhost:3000/api/marketplace/callback/etsy"

# Token encryption (required to connect eBay/Etsy — TokenManager throws
# without it). Must decode to exactly 32 bytes (AES-256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the same key across environments (dev/staging/production).
TOKEN_ENCRYPTION_KEY=""

# Admin access — comma-separated list of email address(es) allowed into
# /dashboard/admin and /api/admin/metrics. Must be set to your own real
# email(s); an unset ADMIN_EMAIL means no one has admin access. This only
# controls authorization for an account that already exists — it does not
# create one (sign up normally, then set this to that account's email).
ADMIN_EMAIL=""

# ADKSY AI Assistant (server-side only — never expose as NEXT_PUBLIC_*)
ANTHROPIC_API_KEY=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Reselling SaaS"


# Email Service Configuration
# Provider options: sendgrid, mailgun, resend, none (default)
# If EMAIL_PROVIDER=none, emails are logged but not sent
EMAIL_PROVIDER="none"
EMAIL_FROM="noreply@resellhub.local"
EMAIL_FROM_NAME="ResellHub"

# SendGrid Configuration (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY="SG.xxxxx"

# Mailgun Configuration (if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY="key-xxxxx"
MAILGUN_DOMAIN="mg.resellhub.local"

# Resend Configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY="re_xxxxx"

# Rate limiting — required on Vercel (each serverless instance has its own
# memory, so without Upstash, limits are not actually enforced in prod).
# Set both to switch automatically; RATE_LIMIT_BACKEND is only needed to
# force a specific backend (e.g. "memory" for local dev, "upstash" to
# require it and fail loudly if the credentials below are missing).
RATE_LIMIT_BACKEND=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry error tracking (optional — disabled when SENTRY_DSN is unset)
SENTRY_DSN=""
ENVIRONMENT="production"
APP_VERSION=""
